// @OA_TARGET@_version.rc
//
// RC resource script for @OA_TARGET@ file version info.
//
// This resource file provides the version information needed for an OA binary.
// Standard versioning information is sourced from the oa/version.h header but
// the following macros should be configured by the build system:
//
//  OA_RC_FILE_TYPE             One of VFT_APP, VFT_DLL, VFT_STATIC_LIB
//  OA_RC_FILE_DESCRIPTION      String literal with descriptive text
//
// See the following link for RC file reference documentation:
// https://learn.microsoft.com/en-us/windows/win32/menurc/versioninfo-resource
//
// Author: Derek Huang
// Copyright: MIT License
//

// note: Windows header defining some of the macros we need. resource files
// generated by Visual Studio will have this include directive
#include "winres.h"

// for OA_* version macros
#include "oa/version.h"

// file type. this should be defined by the build system to one of VFT_APP for
// executables, VFT_DLL for DLLs, VFT_STATIC_LIB for static libraries
#define OA_RC_FILE_TYPE @OA_RC_FILE_TYPE@
// file description. this should be a string literal defined by build system
#define OA_RC_FILE_DESCRIPTION "@OA_RC_FILE_DESCRIPTION@"

// resource version info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     OA_MAJOR_VERSION,OA_MINOR_VERSION,OA_PATCH_VERSION,0
PRODUCTVERSION  OA_MAJOR_VERSION,OA_MINOR_VERSION,OA_PATCH_VERSION,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS
// non-release versions should indicate that they contain debugging info
#if defined(_DEBUG) || !defined(NDEBUG)
                VS_FF_DEBUG |
#endif  // defined(_DEBUG) || !defined(NDEBUG)
// TODO: should define macro to control VS_FF_PRERELEASE inclusion
                VS_FF_PRERELEASE /* | 0 */
// note: technically not correct as we have 64-bit Windows builds
FILEOS          VOS_NT
FILETYPE        OA_RC_FILE_TYPE
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // US English (0x0409) w/ Multilingual (CP-1252) character set (0x04E4)
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "OA Developers"
            VALUE "FileDescription", OA_RC_FILE_DESCRIPTION
            // note: FILEVERSION is displayed in properties, not this field
            VALUE "FileVersion", OA_VERSION
            // note: docs say "InternalName" is required but omitting is ok
            VALUE "LegalCopyright", "MIT License"
            // note: docs say "OriginalFileName" is required but omitting is ok
            // note: ProductName is displayed in properties
            VALUE "ProductName", "OA Software Suite"
            VALUE "ProductVersion", OA_VERSION
        END
    END
    // note: this is required for the StringFileInfo fields to show up
    BLOCK "VarFileInfo"
    BEGIN
        // matches StringFileInfo (US English + CP-1252 character set)
        VALUE "Translation", 0x409, 1252
    END
END
